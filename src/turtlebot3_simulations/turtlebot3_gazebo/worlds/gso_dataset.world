<?xml version="1.0"?>
<sdf version="1.8">
  <world name="gso_dataset">
    <physics type="ode">
      <real_time_update_rate>500</real_time_update_rate>
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.65 0.68 0.72 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.82 0.78 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <light type="point" name="randomized_light_3">
      <pose>30 0 2.2 0 0 0</pose>
      <diffuse>0.95 0.72 0.58 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>7</range><constant>0.4</constant><linear>0.08</linear></attenuation>
    </light>
    <light type="point" name="randomized_light_4">
      <pose>40 -0.8 1.8 0 0 0</pose>
      <diffuse>0.58 0.72 0.98 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>6</range><constant>0.5</constant><linear>0.1</linear></attenuation>
    </light>
    <light type="point" name="randomized_light_5">
      <pose>50 1.0 2.0 0 0 0</pose>
      <diffuse>0.72 0.95 0.68 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>8</range><constant>0.35</constant><linear>0.06</linear></attenuation>
    </light>

    <!-- Discrete bays make material, layout, and lighting variation deterministic offline. -->
    <model name="dataset_bays">
      <static>true</static>
      <link name="geometry">
